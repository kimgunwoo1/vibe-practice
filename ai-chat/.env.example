# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# MongoDB Atlas 접속 주소 (Connect → Drivers에서 복사, <password>를 실제 비밀번호로)
MONGODB_URI=
# 사용할 데이터베이스 이름 (비워 두면 ai-chat)
MONGODB_DB_NAME=ai-chat

# 익명 ID 쿠키 서명용 비밀값. 아래 명령으로 만들어 넣으세요:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
